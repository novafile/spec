# The NOVA standard library of types (proposal 0008). Implementations bundle
# every released version and never fetch it. A fix to a type is a new breaking version (§6.5).
# Generated by std.py: edit that script, not this file.
@schema novafile.dev/std@0.2.0

# ISO 3166-1 alpha-2 country code, by shape only. The ISO list changes, so std does not enumerate it.
type CountryCode = string @pattern("[A-Z]{2}")

# ISO 4217 currency code, by shape only. The ISO list changes, so std does not enumerate it.
type CurrencyCode = string @pattern("[A-Z]{3}")

# ITU-T E.164 telephone number: "+", then 2 to 15 digits, no leading zero. Syntax only.
type E164 = string @pattern("[+][1-9][0-9]{1,14}")

# HTML "valid e-mail address": ASCII only, case preserved. RFC 6531 addresses are out of scope.
type Email = string @pattern("[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?([.][A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*")

# Trimmed single-line text without control characters. Follows the Unicode version of the implementation.
type Name = string @pattern("[^\\p{Z}\\p{Cc}\\p{Cf}]([^\\p{Cc}\\p{Zl}\\p{Zp}]*[^\\p{Z}\\p{Cc}\\p{Cf}])?")

# Text with at least one visible character; may span lines. Follows the Unicode version of the implementation.
type NonBlank = string @pattern("(.|\\n|\\r)*[^\\p{Z}\\p{Cc}\\p{Cf}](.|\\n|\\r)*")

# TCP or UDP port number.
type Port = int @range(0..65535)

# Relative path with "/" separators and POSIX portable file names. Windows reserved names (CON, NUL, ...) are not checked.
type PortablePath = string @len(1..1024, utf8) @pattern("[.]?[A-Za-z0-9_]([A-Za-z0-9._-]*[A-Za-z0-9_-])?(/[.]?[A-Za-z0-9_]([A-Za-z0-9._-]*[A-Za-z0-9_-])?)*")

# Semantic Versioning 2.0.0 version, without a leading "v".
type SemVer = string @pattern("(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)([.](0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?([+][0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?")

# SHA-256 digest as 64 lowercase hex digits.
type Sha256Hex = string @pattern("[0-9a-f]{64}")

# RFC 3986 absolute URI (section 3). Not a WHATWG URL: no whitespace stripping, no IDNs in Unicode form.
