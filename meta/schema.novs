# SPDX-License-Identifier: Apache-2.0
# Normative source: https://github.com/novafile/spec/blob/main/meta/schema.novs
# Copies (e.g. the one embedded in the novafile-schema crate) must stay byte-identical to it.
# The meta-schema: the shape of schema descriptors (spec §6.8).
# A schema's descriptor is ordinary NOVA data; this schema validates it,
# including its own descriptor.
@schema novafile.dev/meta/schema@0.3.5
@root Schema

record Schema:
  name?: string @id(1)
  version?: string @id(2)
  root?: Type @id(3)
  defs: list<Def> @id(4)
  imports?: list<Import> @id(5)

# `@import schema as alias` (proposal 0008). `schema` is `name@version#fingerprint`.
record Import:
  alias: string @key @id(1)
  schema: string @id(2)

# Exactly one of `record`, `enum` and `alias` is present.
record Def @one_of(record, enum, alias):
  name: string @key @id(1)
  record?: RecordDef @id(2)
  enum?: list<VariantDef> @id(3)
  alias?: Type @id(4)
  class?: Class @id(5)        # on records and enums (proposal 0009)

record RecordDef:
  open: bool @id(1) = false
  fields: list<FieldDef> @id(2)
  rules?: list<RecordRule> @id(3)    # proposal 0010

# `@together`, `@one_of` or `@any_of` (proposal 0010): how many of `fields`
# must be present.
record RecordRule:
  kind: RuleKind @id(1)
  fields: list<string> @id(2)

enum RuleKind = together | one_of | any_of

record FieldDef:
  name: string @key @id(1)
  type: Type @id(2)
  optional: bool @id(3) = false
  default?: any @id(4)
  key: bool @id(5) = false
  id?: u32 @id(6)
  deprecated: bool @id(7) = false

record VariantDef:
  name: string @key @id(1)
  payload?: Type @id(2)
  id?: u32 @id(3)

enum Kind = any | null | bool | int | i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | float | decimal | rational | string | bytes | timestamp | duration | list | set | map | tuple | named | union | literal

# `ref` names the definition for `named`; `item` is the element type of
# lists and sets; `key`/`value` describe maps; `items` the tuple elements,
# or the members of a union in order (at least two).
record Type:
  kind: Kind @id(1)
  ref?: string @id(2)
  item?: Type @id(3)
  key?: Type @id(4)
  value?: Type @id(5)
  items?: list<Type> @id(6)
  nullable: bool @id(7) = false
  range?: Range @id(8)
  len?: Len @id(9)
  pattern?: string @id(10)    # an I-Regexp; on `string` or a `named` alias of it
  literal?: string @id(11)    # the value of a `literal` type
  class?: Class @id(12)       # proposal 0009

# Bounds are exact numbers: int, decimal or rational.
record Range:
  min?: any @id(1)
  max?: any @id(2)

enum LenUnit = scalars | utf8 | utf16 | graphemes

record Len:
  min?: u64 @id(1)
  max?: u64 @id(2)
  unit: LenUnit @id(3) = !scalars

# How readers show a value (proposal 0009): a pseudonym for `personal`, a
# placeholder for `secret`.
enum Class = personal | secret
